{
  "name": "ai-interview-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TechInterview Pro — Candidate Portal",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:backend && npm run test:frontend",
    "lint": "eslint . && cd backend && uv run ruff check .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace frontend",
    "db:migrate": "cd backend && uv run python -m techinterview.db.client",
    "db:seed": "cd backend && uv run python -m techinterview.db.seed",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "test:a11y": "npm run test:a11y --workspace frontend",
    "test:perf": "npm run test:perf --workspace frontend",
    "seed": "npm run db:seed",
    "perf:editor": "npm run test:perf --workspace frontend",
    "dev:backend": "cd backend && uv run uvicorn techinterview.main:app --reload --reload-dir src --port 8787",
    "dev:frontend": "npm run dev --workspace frontend",
    "test:backend": "cd backend && uv run pytest",
    "test:frontend": "npm run test --workspace frontend",
    "test:collaboration": "cd backend && uv run pytest tests/collaboration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
