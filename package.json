{
  "name": "ai-interview-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TechInterview Pro — Candidate Portal",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:backend && npm run test:frontend",
    "lint": "eslint . && cd backend && uv run ruff check .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "cd frontend && npx tsc --noEmit",
    "db:migrate": "npx --yes supabase@latest db reset",
    "db:seed": "cd backend && uv run python -m techinterview.db.seed",
    "seed": "cd backend && uv run python -m techinterview.db.seed",
    "dev:backend": "cd backend && uv run uvicorn techinterview.main:app --reload --reload-dir src --port 8787",
    "dev:frontend": "cd frontend && npx next dev --turbopack -p 5173",
    "test:backend": "cd backend && uv run pytest",
    "test:frontend": "cd frontend && npx vitest run",
    "test:collaboration": "cd backend && uv run pytest tests/collaboration",
    "test:e2e": "cd frontend && npx playwright test --project=e2e",
    "test:a11y": "cd frontend && npx playwright test --project=a11y",
    "test:perf": "cd frontend && npx playwright test --project=perf",
    "perf:editor": "cd frontend && npx playwright test --project=perf",
    "db:start": "npx --yes supabase@latest start -x studio,imgproxy,storage-api,edge-runtime,logflare,vector,realtime,pg-meta,mailpit,supavisor",
    "db:stop": "npx --yes supabase@latest stop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
