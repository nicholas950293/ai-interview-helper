# TechInterview Pro — BFF 環境變數
#
# 憲章「憑證隔離」：本檔的任何金鑰 MUST NOT 出現在前端程式碼或 bundle 中。
# 複製為 backend/.env 後填入實際值；.env 已列入 .gitignore。

# --- 伺服器 ---
PORT=8787
NODE_ENV=development

# --- 資料庫（SQLite 單檔） ---
DATABASE_PATH=./data/portal.db

# --- Session Cookie ---
# 32 bytes 以上的隨機字串，用於簽章 session cookie。
# 產生方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-32-byte-random-hex-string
# 正式環境 MUST 設為 true（僅經 HTTPS 傳送 cookie）
COOKIE_SECURE=false

# --- Gemini（僅伺服端使用） ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- AI 行為 ---
# 首個 token 的串流逾時（毫秒）
AI_STREAM_TIMEOUT_MS=20000
