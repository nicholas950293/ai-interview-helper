# TechInterview Pro — BFF 環境變數（Python / FastAPI）
#
# 憲章「憑證隔離」：本檔的任何金鑰 MUST NOT 出現在前端程式碼或 bundle 中。

PORT=8787
ENVIRONMENT=development

# 目前的持久化。Supabase 為已記錄的落差（見下方）
DATABASE_PATH=./data/portal.db

# 產生邀請連結時的網址前綴。正式環境 MUST 設為部署後的前端網址，
# 否則 seed 出來的連結指向 localhost，拿到的人開不起來。
PUBLIC_APP_URL=http://localhost:5173

SESSION_SECRET=change-me-to-a-32-byte-random-hex-string
COOKIE_SECURE=false

# --- Supabase（憲章原則 V）------------------------------------------------
# 尚無程式碼消費這兩個變數——Supabase 遷移（T006、T014–T017）未實作，
# 目前仍走上方 DATABASE_PATH 的 SQLite。
#
# 後端一律以 service role 存取（RLS deny-all，見 research R-004）。
# anon key 在本架構沒有消費者：前端 MUST NOT 持有任何 Supabase 憑證，
# CI 的憑證隔離檢查會掃描建置產物擋下 SUPABASE_SERVICE_ROLE_KEY。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI —— 一律經 LangChain 編排（憲章原則 V）
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=google_genai
# 注意：Google 會下架模型。若後端日誌出現 404 NOT_FOUND，
# 以 ListModels 確認金鑰目前可用的模型（見 quickstart 疑難排解）。
# 免費層每個模型每天 20 次請求，配額按模型分開計算。
AI_MODEL=gemini-3.6-flash
# 主要供應商不可用時的退回（兩者皆填才生效）。
# Gemini 配額用罄（429）時由此接手，正是雙供應商的用途。
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# 串流的閒置逾時（毫秒）：距上一個 token 超過此值即中止，非總時長。
# MUST 明顯小於前方代理的連線逾時（Next dev 約 30 秒），否則錯誤事件
# 來不及送達瀏覽器，使用者會看到誤導的「連線中斷」。
AI_STREAM_TIMEOUT_MS=20000

# 以腳本化假回應取代真實模型；production 一律無效
AI_FAKE=false
